Name:           virt-firmware-rs
Version:        26.4
Release:        %autorelease
Summary:        Tools for EFI and virtual machine firmware

License:        MIT
URL:            https://gitlab.com/kraxel/virt-firmware-rs
Source0:        https://gitlab.com/kraxel/%{name}/-/archive/v%{version}/%{name}-v%{version}.tar.gz
Source1:        %{name}-vendor-v%{version}.tar.gz
Source2:        config-vendor.toml

ExclusiveArch:  x86_64 aarch64 riscv64
BuildRequires:  cargo rustc
BuildRequires:  pkgconfig(libudev)

%description
A collection of tools to deal with efi and virtual machine
firmware.  This package has linux tools.

%prep
%autosetup -n %{name}-v%{version} -p1
tar xf %{SOURCE1}
mkdir -p .cargo
cp %{SOURCE2} .cargo/config.toml

# remove packages not built
sed -e '/mefisto/d' \
    -e '/experimental/d' \
    -e '/efi-apps/d' \
    -i Cargo.toml

%build
cargo build --package virtfw-efi-tools --features udev
cargo build --package virtfw-efi-tools
cargo build --package virtfw-igvm-tools --features authenticode
cargo build --package virtfw-varstore --features std,json,pem

%install
# efi-tools + igvm-tools
install -d %{buildroot}%{_bindir}
install -v -m 755 target/debug/generate-boot-csv %{buildroot}%{_bindir}
install -v -m 755 target/debug/list-sb-vars %{buildroot}%{_bindir}
install -v -m 755 target/debug/mini-bootcfg %{buildroot}%{_bindir}
install -v -m 755 target/debug/virt-fw-vars-setup %{buildroot}%{_bindir}
install -v -m 755 target/debug/uefi-boot-menu %{buildroot}%{_bindir}/uefi-boot-menu-rs
install -v -m 755 target/debug/igvm-inspect %{buildroot}%{_bindir}
install -v -m 755 target/debug/igvm-wrap %{buildroot}%{_bindir}
install -v -m 755 target/debug/igvm-update %{buildroot}%{_bindir}
# rename readme files
for dir in efi-apps efi-tools igvm-tools; do
    cp -v ${dir}/README.md README.${dir}.md
done
# man pages
mkdir -p %{buildroot}%{_mandir}/man1
for app in virt-fw-vars-setup igvm-inspect igvm-wrap igvm-update; do
    %{buildroot}%{_bindir}/${app} --manpage > %{buildroot}%{_mandir}/man1/${app}.1
done

%files
%license LICENSE
%doc README.md
%doc README.efi-tools.md
%doc README.igvm-tools.md
%{_bindir}/generate-boot-csv
%{_bindir}/list-sb-vars
%{_bindir}/mini-bootcfg
%{_bindir}/virt-fw-vars-setup
%{_bindir}/uefi-boot-menu-rs
%{_bindir}/igvm-inspect
%{_bindir}/igvm-wrap
%{_bindir}/igvm-update
%{_mandir}/man1/*

